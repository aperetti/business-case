# Backend Configuration
DATABASE_PATH=./backend/data/bca.db

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Configuration (Vite uses VITE_ prefix; leave empty to use Vite dev proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Optional Environment-Managed Authentication
# Setting ANY non-empty variable in a section below overrides SQLite and locks
# the corresponding section in the Admin Portal (read-only).
# ---------------------------------------------------------------------------

# --- Single Sign-On (SSO) ---
# SSO_ENABLED=true
# SSO_PROVIDER=firebase
# SSO_ENFORCE=false
# SSO_ALLOWED_DOMAINS=company.com,subsidiary.org
# SSO_ADMIN_EMAILS=admin@company.com

# Firebase Auth (used when SSO_PROVIDER=firebase)
# FIREBASE_PROJECT_ID=my-bca-project
# FIREBASE_AUTH_DOMAIN=my-bca-project.firebaseapp.com
# FIREBASE_API_KEY=AIzaSy...
# FIREBASE_APP_ID=1:1234567890:web:abc123
# FIREBASE_TENANT_ID=
# FIREBASE_SIGN_IN_METHODS=google,microsoft

# Microsoft Entra ID (used when SSO_PROVIDER=entra)
# ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_SECRET=
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# ENTRA_REDIRECT_URI=http://localhost:8094/auth/callback
# ENTRA_SCOPES=openid profile email

# --- Inbound API Keys (/v1/* OpenAI gateway & /odata/* BI feed) ---
# Comma-separated or JSON array of static API keys. Overrides DB-issued keys.
# BCA_API_KEYS=bca-your-static-key-1,bca-your-static-key-2
